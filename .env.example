# Copy to .env; NEVER commit that file. Generate SECRET_KEY with the README command.
SECRET_KEY=
PUBLIC_URL=https://leihnest.de
ALLOW_SIGNUP=0
# Trust only the real reverse proxy IP/subnet, never arbitrary public clients.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional: messages remain in the outbox until an operator runs the mail command.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=0
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
